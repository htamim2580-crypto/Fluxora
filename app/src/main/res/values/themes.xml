<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Fluxora" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Core Palette Mapping -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <!-- Background & Surface Layers -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_primary_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>

        <!-- Error Semantics -->
        <item name="colorError">@color/danger</item>
        <item name="colorErrorContainer">@color/danger_container</item>
        <item name="colorOnErrorContainer">@color/on_danger_container</item>

        <!-- Seamless Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Global Component Defaults -->
        <item name="materialCardViewStyle">@style/Widget.Fluxora.CardView</item>
        <item name="materialButtonStyle">@style/Widget.Fluxora.Button.Primary</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Fluxora.BottomSheetDialog</item>
    </style>

    <style name="Theme.Fluxora" parent="Base.Theme.Fluxora" />

    <!-- Quiet Luxury Card: Soft Oat surface, 20dp radius, zero drop-shadow -->
    <style name="Widget.Fluxora.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <!-- Primary Pill Button: Muted Sage, generous touch target -->
    <style name="Widget.Fluxora.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary Tonal Pill Button: Warm Sand -->
    <style name="Widget.Fluxora.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Clean Input Fields: Rounded 16dp, subtle outline -->
    <style name="Widget.Fluxora.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <!-- Smooth 24dp Top-Corner Bottom Sheets -->
    <style name="ThemeOverlay.Fluxora.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Fluxora.BottomSheet</item>
    </style>

    <style name="Widget.Fluxora.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fluxora.BottomSheet</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="ShapeAppearance.Fluxora.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>